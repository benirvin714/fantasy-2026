.claude/settings.local.json

# Local build cache: DynastyProcess player-ID crosswalk (2.5MB, refetched each build).
# Not committed — the build runs locally and Cloudflare only serves the derived JSON.
data/raw/db_playerids.csv

# Local build caches so an UNATTENDED rebuild degrades to yesterday's data instead of
# publishing nulls when S3/Sleeper blips. Derived and refetched every build; never committed.
data/raw/fftiers-half-ppr.csv
data/raw/byes-2026.json

# Local quarantine record written by scripts/validate-events.mjs each run. Reviewed via
# the routine's morning summary, not published. Regenerated every run, never committed.
data/raw/nfl-events-flags.json

# Local coverage + validation report written by scripts/validate-scouting.mjs. Regenerated
# each run, reviewed on demand, never committed.
data/raw/scouting-flags.json

# Throwaway prototype — lives on branch prototype/adp-mispricing, never on main.
# Ignored here because OneDrive restores the directory after deletion, so it would
# otherwise keep reappearing as untracked and risk being swept into a `git add .`.
scripts/PROTOTYPE-adp-mispricing/
